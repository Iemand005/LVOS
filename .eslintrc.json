{
  "env": {
    "browser": true,
    "es6": false
  },
  "rules": {
    "comma-dangle": ["error", "never"],
    "no-var": "off",
    "no-sequences": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.property.name='addEventListener'][arguments.length=2]",
        "message": "addEventListener requires a third options parameter for browser compatibility."
      }
    ]
  }
}
