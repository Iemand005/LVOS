{
	"editor.tabSize": 4,
	"editor.indentSize": "tabSize",
	"editor.insertSpaces": false,
	"chat.disableAIFeatures": true,
	"editor.inlineSuggest.enabled": true,
	"files.associations": {
		"*.hta": "html"
	},
	"cSpell.words": [
		"contenteditable",
		"devel",
		"Lasse",
		"Lauwerys"
	],
	"workbench.colorCustomizations": {
		"activityBar.background": "#ca5406",
		"activityBar.foreground": "#f7f6f6",
		"titleBar.activeBackground": "#D95D0A",
		"titleBar.activeForeground": "#FFF8F4",
		"titleBar.inactiveBackground": "#9B4207",
		"titleBar.inactiveForeground": "#FFF8F4",
		"statusBar.background": "#9B4207",
		"statusBar.foreground": "#FFF8F4",
		"statusBar.debuggingBackground": "#9B4207",
		"statusBar.debuggingForeground": "#FFF8F4",
		"statusBar.noFolderBackground": "#9B4207",
		"statusBar.noFolderForeground": "#FFF8F4"
	},
	"workbench.browser.autoReloadOnFileChange": true,
	"workbench.browser.showInTitleBar": true,
	"git.detectSubmodulesLimit": 20,
	"liveServer.settings.port": 5501,
	"javascript.inlayHints.parameterTypes.enabled": true,
	"javascript.inlayHints.variableTypes.enabled": true,
	"javascript.inlayHints.propertyDeclarationTypes.enabled": true,
	"javascript.inlayHints.functionLikeReturnTypes.enabled": true,
	"js/ts.inlayHints.parameterTypes.enabled": true,
	"js/ts.inlayHints.parameterNames.enabled": "all",
	"tabStack.history.maxEntries": 100,
	"tabStack.gitIntegration.enabled": false,
	"tabStack.gitIntegration.mode": "auto-create",
}
