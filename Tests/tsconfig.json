{
	// Tests run in Node (Playwright) but their evaluate callbacks run in the browser,
	// so this project is the only place `node` types are allowed: NodeJS.Timeout for
	// the runner side, DOM for the page side. The root jsconfig stays node-free —
	// `@types/node` redeclares the global `setTimeout` as returning Timeout, and that
	// wins over lib.dom's `number` as soon as it is in the same program.
	"extends": "../jsconfig.json",
	"compilerOptions": {
		"types": ["node", "w3c-web-hid"],
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		// Only the .ts specs live here; pulling node types drags .js files (punycode)
		// into the program, which this project must not try to type-check.
		"checkJs": false,
		"skipLibCheck": true,
		"traceResolution": false
	},
	"include": [
		"./*.ts",
		"../types.d.ts",
		"../overrides.d.ts"
	],
	"exclude": [
		"../node_modules",
		"../Applications"
	]
}
